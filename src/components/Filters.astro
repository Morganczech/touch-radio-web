---
interface Props {
  uniqueCountries: string[];
  uniqueGenres: string[];
  uniqueCodecs: string[];
}

const { uniqueCountries, uniqueGenres, uniqueCodecs } = Astro.props;
---

<div class="filters-wrapper">
  <button
    id="toggle-filters-btn"
    class="toggle-filters-btn"
    aria-expanded="false"
    aria-controls="filters-panel"
    type="button"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path fill="currentColor" d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"></path>
    </svg>
    <span>Show advanced filters</span>
  </button>
  <div id="filters-panel" class="filters-panel" aria-hidden="true">
    <div class="filters-inner">
      <div class="filters-container">
        <label class="filter-field">
          <span class="filter-label">Region / Country</span>
          <select id="country-filter" class="hero-filter">
            <option value="">All Territories</option>
            {uniqueCountries.map((country) => (
              <option value={country}>{country}</option>
            ))}
          </select>
        </label>
        <label class="filter-field">
          <span class="filter-label">Genre</span>
          <select id="genre-filter" class="hero-filter">
            <option value="">All Genres</option>
            {uniqueGenres.map((genre) => (
              <option value={genre}>{genre}</option>
            ))}
          </select>
        </label>
        <label class="filter-field">
          <span class="filter-label">Codec</span>
          <select id="codec-filter" class="hero-filter">
            <option value="">All Codecs</option>
            {uniqueCodecs.map((codec) => (
              <option value={codec}>{codec}</option>
            ))}
          </select>
        </label>
        <label class="filter-field">
          <span class="filter-label">Min bitrate</span>
          <input
            type="number"
            id="bitrate-filter"
            class="hero-filter bitrate-input"
            placeholder="e.g. 128"
          />
        </label>
        <button id="clear-filters-btn" class="clear-btn" type="button">Clear filters</button>
      </div>
    </div>
  </div>
</div>

<style>
  .filters-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1.25rem;
    padding: 0 var(--gutter-desktop);
  }

  .toggle-filters-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--surface-low);
    border: 1px solid transparent;
    color: var(--on-surface-variant);
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    margin: 0;
  }

  .toggle-filters-btn:hover {
    color: var(--on-surface);
    background: var(--surface-container);
    border-color: transparent;
  }

  .filters-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 0.3s ease-out,
      opacity 0.3s ease-out,
      transform 0.3s ease-out,
      visibility 0.3s,
      margin-top 0.3s;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    width: 100%;
    max-width: 960px;
  }

  .filters-panel.expanded {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    margin-top: 0.75rem;
  }

  .filters-inner {
    min-height: 0;
    overflow: hidden;
  }

  .filters-container {
    padding: 1.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.85rem;
    align-items: end;
    background: color-mix(in srgb, var(--surface-low) 90%, transparent);
    backdrop-filter: blur(8px);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
  }

  .filter-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: left;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-surface-variant);
  }

  .hero-filter {
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    background: var(--surface-container);
    font-size: 0.85rem;
    cursor: pointer;
    color: var(--on-surface);
    width: 100%;
  }

  .hero-filter:focus {
    outline: none;
    background: var(--surface-high);
  }

  .bitrate-input {
    cursor: text;
  }

  .clear-btn {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0.55rem;
    margin: 0;
    justify-self: start;
  }

  .clear-btn:hover {
    color: var(--on-surface);
    border-color: transparent;
  }
</style>
