---

---

<div id="player-dock" class="player-dock" data-active="false" data-has-station="false">
  <div class="dock-inner">
    <button type="button" id="dock-now-playing" class="now-playing" aria-label="Open now playing">
      <div class="np-art-wrap">
        <img data-player-art id="dock-favicon" class="np-art" src="/logo.svg" alt="" width="52" height="52" />
        <span class="np-live-dot pulse-live" aria-hidden="true"></span>
      </div>
      <div class="np-meta">
        <div class="np-title-row">
          <strong data-player-name id="dock-station-name" class="np-name">Select a station</strong>
          <span data-player-live id="dock-live-badge" class="live-badge" hidden>LIVE</span>
          <span class="sleep-pill" data-sleep-countdown hidden></span>
        </div>
        <p data-player-meta id="dock-station-meta" class="np-sub">Browse and press play to start streaming</p>
      </div>
      <span class="dock-expand-hint" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 8l-6 6 1.41 1.41L12 10.83l4.59 4.58L18 14z"></path></svg>
      </span>
    </button>

    <div class="dock-transport">
      <button type="button" id="dock-prev" class="dock-icon-btn" aria-label="Previous in selection" title="Previous">
        <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M6 6h2v12H6zm3.5 6 8.5 6V6z"></path></svg>
      </button>
      <button type="button" id="dock-play" class="dock-play-btn" data-player-play aria-label="Play" disabled>
        <svg class="icon-play" viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M8 5v14l11-7z"></path></svg>
        <svg class="icon-pause" viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path></svg>
      </button>
      <button type="button" id="dock-next" class="dock-icon-btn" aria-label="Next in selection" title="Next">
        <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"></path></svg>
      </button>
      <button type="button" id="dock-expand" class="dock-icon-btn dock-expand-btn" aria-label="Expand player">
        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"></path></svg>
      </button>
    </div>

    <div class="dock-controls">
      <div class="volume-wrap">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path></svg>
        <input type="range" id="dock-volume" min="0" max="1" step="0.01" value="1" aria-label="Volume" />
      </div>
      <span data-player-quality id="dock-quality" class="quality-pill">—</span>
      <div class="viz" aria-hidden="true" id="dock-viz">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
  </div>
</div>

<style>
  .player-dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    height: var(--player-h);
    background: var(--glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--bevel);
  }

  @media (max-width: 1024px) {
    .player-dock {
      bottom: var(--mobile-nav-h);
    }
  }

  .dock-inner {
    max-width: 1680px;
    margin: 0 auto;
    height: 100%;
    padding: 0 var(--gutter-desktop);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .dock-inner {
      grid-template-columns: 1fr auto;
      padding: 0 var(--gutter);
    }
    .dock-controls {
      display: none !important;
    }
    .dock-expand-btn {
      display: none !important;
    }
  }

  .now-playing {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }

  .now-playing:hover {
    border-color: transparent;
    color: inherit;
  }

  .np-art-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .np-art {
    width: 52px;
    height: 52px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--surface-highest);
    border: 1px solid var(--border);
  }

  .np-live-dot {
    display: none;
    position: absolute;
    right: -2px;
    bottom: -2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--secondary);
    border: 2px solid var(--surface-lowest);
  }

  .player-dock[data-active="true"] .np-live-dot {
    display: block;
  }

  .np-meta {
    min-width: 0;
    flex: 1;
  }

  .np-title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .np-name {
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .live-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--secondary);
    background: rgba(78, 222, 163, 0.12);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .sleep-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--on-primary);
    background: var(--primary-container);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sleep-pill[data-fading="true"] {
    background: var(--secondary);
    color: var(--on-secondary);
  }

  .np-sub {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    color: var(--on-surface-variant);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dock-expand-hint {
    display: none;
    color: var(--on-surface-variant);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .dock-expand-hint {
      display: inline-flex;
    }
  }

  .dock-transport {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dock-icon-btn {
    width: 40px;
    height: 40px;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: var(--on-surface-variant);
    border-radius: var(--radius-full);
  }

  .dock-icon-btn:hover:not(:disabled) {
    color: var(--on-surface);
    background: var(--surface-high);
  }

  .dock-play-btn {
    width: 48px;
    height: 48px;
    padding: 0;
    margin: 0;
    border: none;
    border-radius: 50%;
    background: var(--primary-container);
    color: var(--on-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 20px rgba(0, 229, 255, 0.25);
  }

  .dock-play-btn:hover:not(:disabled) {
    transform: scale(1.05);
    border-color: transparent;
    color: var(--on-primary);
  }

  .dock-play-btn:disabled {
    opacity: 0.4;
  }

  .dock-play-btn .icon-pause {
    display: none;
  }

  .player-dock[data-active="true"] .dock-play-btn .icon-play {
    display: none;
  }

  .player-dock[data-active="true"] .dock-play-btn .icon-pause {
    display: block;
  }

  .dock-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .volume-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--on-surface-variant);
    max-width: 140px;
  }

  .volume-wrap input[type="range"] {
    width: 90px;
    accent-color: var(--primary-container);
  }

  .quality-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--surface-high);
    color: var(--primary-container);
    white-space: nowrap;
  }

  .viz {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 20px;
    opacity: 0.4;
  }

  .viz span {
    width: 3px;
    height: 4px;
    border-radius: 1px;
    background: var(--primary-container);
  }

  .player-dock[data-active="true"] .viz {
    opacity: 1;
  }

  .player-dock[data-active="true"] .viz.is-css-fallback span,
  .player-dock[data-active="true"] .viz:not(.is-live-spectrum) span {
    animation: wave-bar-dock 0.85s ease-in-out infinite;
  }

  .player-dock[data-active="true"] .viz.is-live-spectrum span {
    animation: none;
    min-height: 3px;
  }

  .player-dock[data-active="true"] .viz span:nth-child(1) { animation-duration: 0.7s; }
  .player-dock[data-active="true"] .viz span:nth-child(2) { animation-duration: 0.95s; animation-delay: 0.12s; }
  .player-dock[data-active="true"] .viz span:nth-child(3) { animation-duration: 0.8s; animation-delay: 0.05s; }
  .player-dock[data-active="true"] .viz span:nth-child(4) { animation-duration: 1.05s; animation-delay: 0.2s; }
  .player-dock[data-active="true"] .viz span:nth-child(5) { animation-duration: 0.75s; animation-delay: 0.08s; }
</style>
