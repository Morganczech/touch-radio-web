---

---

<section class="hero-section" id="discover">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">
      <span class="eyebrow-dot pulse-live" aria-hidden="true"></span>
      STREAM ENGINE · ZERO TRACKING · OPEN DIRECTORY
    </div>
    <h1>Discover radio, <span class="accent">your way</span></h1>
    <p class="hero-subtitle">
      Browse verified community streams worldwide. No algorithmic interference,
      no profiling. Pure acoustic frequencies.
    </p>
    <div class="search-container">
      <div class="search-shell">
        <svg class="search-leading" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path>
        </svg>
        <input
          type="search"
          id="search-input"
          class="hero-search"
          placeholder="Try 'ambient tokyo', 'jazz 320k', 'bbc world'..."
          autocomplete="off"
        />
        <kbd class="search-shortcut">Ctrl K</kbd>
      </div>
      <div class="discovery-row">
        <span class="trending-label">Trending</span>
        <div class="discovery-items" id="discovery-badges-container">
          <span class="discovery-item" data-query="Relax" tabindex="0" role="button">Relax</span>
          <span class="discovery-item" data-query="Calm" tabindex="0" role="button">Calm</span>
          <span class="discovery-item" data-query="Night" tabindex="0" role="button">Night</span>
          <span class="discovery-item" data-query="Chill" tabindex="0" role="button">Chill</span>
          <span class="discovery-item" data-query="Ambient" tabindex="0" role="button">Ambient</span>
        </div>
        <div class="discovery-controls">
          <span id="discovery-up" class="arrow arrow-up" role="button" tabindex="0"></span>
          <span id="discovery-down" class="arrow arrow-down" role="button" tabindex="0"></span>
        </div>
      </div>
      <div id="smart-hint" class="smart-hint"></div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 2.5rem var(--gutter-desktop) 1.5rem;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    top: -8rem;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 360px;
    background: linear-gradient(
      to bottom,
      rgba(0, 229, 255, 0.1),
      rgba(0, 218, 243, 0.04),
      transparent
    );
    filter: blur(48px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--surface-high);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--primary-container);
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem;
    color: var(--on-surface);
  }

  .accent {
    color: var(--primary-container);
  }

  .hero-subtitle {
    font-size: 0.95rem;
    color: var(--on-surface-variant);
    margin: 0 auto 2rem;
    max-width: 560px;
    line-height: 1.55;
  }

  .search-shell {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--surface-lowest);
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }

  .search-shell:focus-within {
    border-color: var(--focus-ring);
    box-shadow: 0 0 12px var(--focus-glow);
    background: var(--surface-low);
  }

  .search-leading {
    margin-left: 1rem;
    color: var(--on-surface-variant);
    flex-shrink: 0;
  }

  .hero-search {
    flex: 1;
    width: 100%;
    min-width: 0;
    height: 54px;
    padding: 0 5rem 0 0.75rem;
    font-size: 0.95rem;
    color: var(--on-surface);
    background: transparent;
    border: none;
    outline: none;
  }

  .hero-search::placeholder {
    color: var(--outline);
  }

  .search-shortcut {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    display: none;
  }

  @media (min-width: 640px) {
    .search-shortcut {
      display: inline-flex;
    }
  }

  .discovery-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem auto 0.25rem;
    max-width: 640px;
  }

  .trending-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--outline);
    margin-right: 0.25rem;
  }

  .discovery-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .discovery-items.fade-out {
    opacity: 0;
    transform: translateY(2px);
  }

  .discovery-item {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--on-surface);
    background: var(--surface-high);
    border: none;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background 0.2s, color 0.2s, box-shadow 0.2s;
    user-select: none;
  }

  .discovery-item:hover,
  .discovery-item:focus-visible {
    background: var(--badge-bg);
    color: var(--primary-container);
    outline: none;
  }

  .discovery-controls {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-left: 0.25rem;
  }

  .arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    opacity: 0.5;
    cursor: pointer;
  }

  .arrow:hover {
    opacity: 0.9;
  }

  .arrow-up {
    border-bottom: 6px solid var(--on-surface-variant);
  }

  .arrow-down {
    border-top: 6px solid var(--on-surface-variant);
  }

  .smart-hint {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.75rem;
    min-height: 1.5em;
    opacity: 0;
    transform: translateY(-4px);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    font-weight: 500;
    pointer-events: none;
  }

  .smart-hint.active {
    opacity: 0.85;
    transform: translateY(0);
  }
</style>
