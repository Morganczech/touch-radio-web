---

---

<header class="app-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Touch Radio home">
      <img src="/logo.svg" alt="" class="brand-logo" width="32" height="32" />
      <div class="brand-text">
        <span class="brand-name">Touch Radio</span>
        <span class="live-pill">
          <span class="live-dot pulse-live" aria-hidden="true"></span>
          <span id="header-station-count">7,000+</span> Online
        </span>
      </div>
    </a>

    <nav class="header-nav" aria-label="Primary">
      <a class="nav-link is-active" href="#discover" data-nav="discover">Discover</a>
      <a class="nav-link" href="#discover" data-nav="countries" id="nav-countries">Countries</a>
      <a class="nav-link" href="#discover" data-nav="genres" id="nav-genres">Genres</a>
      <a class="nav-link" href="#discover" data-nav="favorites" id="nav-favorites">Favorites</a>
    </nav>

    <div class="header-actions">
      <div class="header-search">
        <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path>
        </svg>
        <input
          type="search"
          id="header-search-input"
          placeholder="Search stations..."
          autocomplete="off"
        />
        <kbd class="search-kbd">Ctrl K</kbd>
      </div>
      <button
        type="button"
        id="theme-toggle"
        class="icon-btn"
        aria-label="Theme is dark (Hi-Fi mode)"
        title="Hi-Fi dark mode"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"></path>
        </svg>
      </button>
      <button
        type="button"
        class="icon-btn"
        id="header-favorites-btn"
        aria-label="Open favorites"
        title="Favorites"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .app-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--surface-lowest) 85%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--header-shadow);
  }

  .header-inner {
    height: 100%;
    max-width: 1680px;
    margin: 0 auto;
    padding: 0 var(--gutter-desktop);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 32px;
    height: 32px;
    border-radius: 8px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
    background: var(--surface-high);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--secondary);
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--surface-low);
    border-radius: var(--radius-md);
  }

  @media (min-width: 1100px) {
    .header-nav {
      display: flex;
    }
  }

  .nav-link {
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius);
    color: var(--on-surface-variant);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
  }

  .nav-link:hover {
    color: var(--on-surface);
    background: var(--surface-high);
  }

  .nav-link.is-active {
    background: var(--surface-high);
    color: var(--primary);
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    justify-content: flex-end;
    max-width: 420px;
  }

  .header-search {
    position: relative;
    display: none;
    flex: 1;
    max-width: 280px;
  }

  @media (min-width: 640px) {
    .header-search {
      display: block;
    }
  }

  .search-icon {
    position: absolute;
    left: 0.7rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--on-surface-variant);
    pointer-events: none;
  }

  .header-search input {
    width: 100%;
    padding: 0.45rem 3.5rem 0.45rem 2.2rem;
    background: var(--surface-low);
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--on-surface);
    font-size: 0.85rem;
  }

  .header-search input:focus {
    outline: none;
    border-color: var(--focus-ring);
    box-shadow: 0 0 12px var(--focus-glow);
  }

  .header-search input::placeholder {
    color: var(--outline);
  }

  .search-kbd {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
    border-radius: var(--radius);
    color: var(--on-surface-variant);
  }

  .icon-btn:hover {
    background: var(--surface-high);
    color: var(--on-surface);
    border-color: transparent;
  }
</style>

<script>
  function onReady(fn: () => void) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", fn, { once: true });
    } else {
      fn();
    }
  }

  onReady(() => {
    const headerSearch = document.getElementById("header-search-input") as HTMLInputElement | null;
    const mainSearch = document.getElementById("search-input") as HTMLInputElement | null;

    if (headerSearch && mainSearch) {
      headerSearch.addEventListener("input", () => {
        mainSearch.value = headerSearch.value;
        mainSearch.dispatchEvent(new Event("input", { bubbles: true }));
      });
      mainSearch.addEventListener("input", () => {
        if (document.activeElement !== headerSearch) {
          headerSearch.value = mainSearch.value;
        }
      });
    }

    document.getElementById("header-favorites-btn")?.addEventListener("click", async () => {
      const { openFavoritesSheet } = await import(
        "../scripts/selection/selectionManager"
      );
      openFavoritesSheet();
    });

    document.getElementById("nav-countries")?.addEventListener("click", (e) => {
      e.preventDefault();
      const btn = document.getElementById("toggle-filters-btn");
      const panel = document.getElementById("filters-panel");
      if (panel && !panel.classList.contains("expanded")) btn?.click();
      document.getElementById("country-filter")?.focus();
    });

    document.getElementById("nav-genres")?.addEventListener("click", (e) => {
      e.preventDefault();
      const btn = document.getElementById("toggle-filters-btn");
      const panel = document.getElementById("filters-panel");
      if (panel && !panel.classList.contains("expanded")) btn?.click();
      document.getElementById("genre-filter")?.focus();
    });

    document.querySelector('[data-nav="discover"]')?.addEventListener("click", (e) => {
      e.preventDefault();
      document.querySelectorAll("[data-nav]").forEach((link) => {
        link.classList.toggle(
          "is-active",
          (link as HTMLElement).dataset.nav === "discover",
        );
      });
      document.getElementById("discover")?.scrollIntoView({ behavior: "smooth" });
    });

    document.getElementById("nav-favorites")?.addEventListener("click", async (e) => {
      e.preventDefault();
      document.querySelectorAll("[data-nav]").forEach((link) => {
        link.classList.toggle(
          "is-active",
          (link as HTMLElement).dataset.nav === "favorites",
        );
      });
      const { openFavoritesSheet } = await import(
        "../scripts/selection/selectionManager"
      );
      openFavoritesSheet();
    });
  });
</script>
